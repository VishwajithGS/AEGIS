# AEGIS environment overrides (placeholders only - the local demo stack has no credentials).
# Any value in config/aegis.yaml can be overridden as AEGIS__<SECTION>__<KEY>.
# docker-compose.yml already sets the container values; use these when running
# Python tools on the Windows host (.venv).

# Kafka (host clients use the PLAINTEXT_HOST listener)
AEGIS__KAFKA__BOOTSTRAP_SERVERS=localhost:9092

# HBase Thrift server
AEGIS__HBASE__HOST=localhost
AEGIS__HBASE__PORT=9090

# Storage root (relative to the project root unless absolute)
AEGIS__STORAGE__DATA_ROOT=data

# Generator
AEGIS__GENERATOR__SEED=42
AEGIS__GENERATOR__LIVE_RATE_PER_SEC=4

# API
AEGIS_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AEGIS_API_LIVE_FEED=1
AEGIS_API_MODEL=1
AEGIS_LOG_LEVEL=INFO

# Alternative config file
# AEGIS_CONFIG=config/aegis.yaml
