# Normalise text files in the repository; let Git pick native endings on checkout.
* text=auto

# Files used inside Linux containers must keep LF (CRLF breaks bash/entrypoints).
*.sh          text eol=lf
Dockerfile    text eol=lf
*.xml         text eol=lf
docker-compose.yml text eol=lf
*.jsonl       text eol=lf

# Windows scripts
*.ps1         text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.parquet binary
